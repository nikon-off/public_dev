<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ====================================================================
         XML → JSON конвертер (настройки 1С:Предприятие DCS, xmlFilter)
         ==================================================================== -->
    <groupId>com.example</groupId>
    <artifactId>xml-to-json-converter</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>xml-to-json-converter</name>
    <description>Конвертер XML-строк (Settings 1С) в JSON на базе Jackson</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Java 21: release управляет и source, и target, и API (Java 9+) -->
        <maven.compiler.release>21</maven.compiler.release>

        <!--
          Версии Jackson проверены через Context7 MCP (2026-09-13).
          Линия 2.x (com.fasterxml.jackson.*) — стабильная, индустриальный стандарт,
          совместима с экосистемой Spring Boot 3.x. Актуальная версия: 2.21.2.
          Альтернатива: Jackson 3.x (tools.jackson.core) — новый major с другим namespace.
        -->
        <jackson.version>2.21.2</jackson.version>

        <!--
          JUnit 5 (Jupiter): версия проверена через Context7 MCP (2026-09-13),
          стабильная линия 5.13.x. Surefire 3.5.x умеет запускать JUnit Platform
          из коробки (без vintage-моста).
        -->
        <junit.jupiter.version>5.13.4</junit.jupiter.version>
        <maven-surefire.version>3.5.2</maven-surefire.version>

        <!--
          AssertJ Core: последняя стабильная версия линии 3.x проверена через
          Maven Central metadata (2026-09-13): 3.27.7. JSON-ассерты
          (assertThatJson / inPath) входят в состав assertj-core, отдельный
          артефакт не нужен. 4.0.0-M1 — milestone, не используется.
        -->
        <assertj.version>3.27.7</assertj.version>

        <!--
          maven-assembly-plugin: конфигурация (descriptorRef jar-with-dependencies,
          archive/manifest/mainClass, execution на фазе package) проверена через
          Context7 MCP по официальной документации Apache Maven (2026-09-13).
        -->
        <maven-assembly.version>3.8.0</maven-assembly.version>
    </properties>

    <!-- jackson-bom: единое управление версиями всех артефактов Jackson
         (databind, core, annotations, dataformat-xml выходят синхронно).
         Рекомендовано официальной документацией FasterXML. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Работа с JSON: сериализация/десериализация объектов и дерева JsonNode.
             Транзитивно тянет jackson-core и jackson-annotations. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Парсинг XML из строки: XmlMapper.readTree(String) для xmlFilter из 1С.
             Транзитивно тянет jackson-module-jakarta-xmlbind-annotations. -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-xml</artifactId>
        </dependency>

        <!-- Тестирование: JUnit 5 (Jupiter API + Engine + Parameterized).
             Агрегатор junit-jupiter достаточно указать одним артефактом. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- AssertJ: fluent-ассерты, включая JSON-ассерты (assertThatJson/inPath)
             для интеграционного теста структуры выходного JSON. -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Явная версия surefire: гарантирует поддержку JUnit Platform
                 независимо от Maven-дистрибутива. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire.version}</version>
            </plugin>

            <!-- Сборка исполняемого fat jar (uber jar) со всеми зависимостями.
                 Итоговый артефакт: target/xml-to-json-converter-1.0.0-SNAPSHOT-jar-with-dependencies.jar
                 Запуск: java -jar <jar> <input-file.json> -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>${maven-assembly.version}</version>
                <configuration>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                    <archive>
                        <manifest>
                            <mainClass>com.example.converter.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>